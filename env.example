# Development settings only. Copy this file to .env (which is never committed):
#   cp .env.example .env
# Docker Compose and goose both read .env automatically.

# Postgres creates this user and database the first time its volume is empty.
POSTGRES_USER=snowball
POSTGRES_PASSWORD=snowball-dev-only
POSTGRES_DB=snowball

# Where goose applies migrations.
GOOSE_DRIVER=postgres
GOOSE_DBSTRING=postgres://snowball:snowball-dev-only@localhost:5432/snowball?sslmode=disable
GOOSE_MIGRATION_DIR=migrations
